; Engine configuration file.
; Godot 4.7 - Ashen Oath

config_version=5

[application]

config/name="Ashen Oath"
config/description="A dark-medieval pocket ARPG through the Barrow Lands."
config/version="2.0.0"
run/main_scene="res://scenes/ui/main_shell.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.05, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Ota="*res://scripts/ota_boot.gd"
AudioDirector="*res://scripts/audio_director.gd"
GameState="*res://scripts/core/game_state.gd"

[ota]

build=0
sha=""

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/ios/allow_high_refresh_rate=true

